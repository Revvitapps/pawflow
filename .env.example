# Postgres — local dev uses a local Postgres; production needs a real managed URL.
DATABASE_URL="postgresql://user:pass@localhost:5432/pawflow_dev?schema=public"
# next-auth v5 — generate with: openssl rand -base64 33
AUTH_SECRET=

# MFA (@revvitapps/auth-mfa) — 32+ char key that encrypts every TOTP secret at
# rest with AES-256-GCM. STRONGLY recommended in production: without it, TOTP
# secrets are stored in plaintext and a leaked DB hands over every user's live
# second factor. Must be STABLE and identical on every process that verifies
# codes — rotating it invalidates all existing enrollments. Generate with:
# openssl rand -base64 33
MFA_SECRET_KEY=

# Claude provider — leave blank to disable AI features gracefully. Never commit a key.
ANTHROPIC_API_KEY=
# Optional: override the model (pricing known for sonnet-4-6 / opus-5 / opus-4-8 / haiku-4-5).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional cap overrides (defaults shown).
AI_MINUTE_MAX_CALLS=12
AI_DAILY_CAP_USD=2
AI_DAILY_MAX_CALLS=200
AI_MONTHLY_CAP_USD=20
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
